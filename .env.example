# ========================================================
# KhojSetu / FoundBeacon Environment Configuration Template
# Copy this file to .env before starting services
# ========================================================

# Environment
NODE_ENV=development
PORT=3001

# PostgreSQL + PostGIS Database
# Example: postgresql://postgres:postgres@localhost:5432/khojsetu
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/khojsetu?schema=public"

# Redis for BullMQ Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# S3 / MinIO Object Storage for OWASP Photo Uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=khojsetu-photos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# OpenTelemetry Collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Web Frontend URL (CORS)
WEB_URL=http://localhost:3000
